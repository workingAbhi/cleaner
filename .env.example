# App (read by react-native-config — rebuild after changes)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
IMAGE_EDIT_WINDOW_HOURS=2
MASTER_OWNER_PHONE=9999999999

# Scripts only (push-config.mjs) — NEVER put service_role in the mobile app
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# OTP_PEPPER=long-random-string
# OTP_DEV_MODE=true
